{
	"name": "@backtix-service/admin-panel",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"start": "ts-node -r dotenv/config ./build",
		"dev": "vite dev",
		"dev:host": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest --run",
		"test:unit:watch": "vitest",
		"start:noenv": "HOST=0.0.0.0 PORT=3001 ts-node ./build"
	},
	"dependencies": {
		"@prisma/client": "^6.19.3",
		"apexcharts": "^5.16.0",
		"dotenv": "^17.4.2",
		"redis": "^6.2.0"
	},
	"devDependencies": {
		"@backtix-service/config": "^1.0.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@typescript-eslint/eslint-plugin": "^8.66.0",
		"@typescript-eslint/parser": "^8.66.0",
		"autoprefixer": "^10.5.4",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"postcss": "^8.5.25",
		"postcss-load-config": "^6.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prisma": "^6.19.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^7.3.6",
		"vitest": "^4.1.10"
	},
	"type": "module",
	"description": "Everything you need to build a Svelte project, powered by [`create-svelte`](https://github.com/sveltejs/kit/tree/main/packages/create-svelte).",
	"main": "svelte.config.js",
	"directories": {
		"test": "tests"
	},
	"author": "",
	"license": "ISC"
}
