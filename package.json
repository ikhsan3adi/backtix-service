{
  "name": "backtix-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test --workspaces",
    "start": "npm run start:prod --workspace=@backtix-service/api",
    "start:dev": "npm run start:dev --workspace=@backtix-service/api",
    "admin:dev": "npm run dev --workspace=@backtix-service/admin-panel",
    "admin:dev:host": "npm run dev:host --workspace=@backtix-service/admin-panel",
    "admin:build": "npm run build --workspace=@backtix-service/admin-panel",
    "admin:preview": "npm run preview --workspace=@backtix-service/admin-panel",
    "admin:start": "npm run start --workspace=@backtix-service/admin-panel",
    "db:seed": "ts-node prisma/seed.ts",
    "start:conc": "concurrently \"npm start\" \"npm run admin:build && npm run start:noenv --workspace=@backtix-service/admin-panel\"",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:down:v": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:test": "docker compose exec api npm run test",
    "docker:test:e2e": "docker compose exec api npm run test:e2e",
    "docker:ps": "docker compose ps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "apps/admin-panel",
    "apps/api",
    "packages/config"
  ],
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
	"devDependencies": {
		"concurrently": "^10.0.4"
	},
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "allowScripts": {
    "@nestjs/core@11.1.28": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@swc/core@1.15.47": true,
    "bcrypt@6.0.0": true,
    "core-js@2.6.12": true,
    "esbuild@0.17.17": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "svelte-preprocess@6.0.4": true
  },
  "overrides": {
    "js-yaml": "^5.2.3"
  }
}
