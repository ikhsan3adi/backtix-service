FROM node:22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package.json package-lock.json tsconfig.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/admin-panel/package.json apps/admin-panel/package.json
COPY packages/config packages/config
COPY prisma prisma
RUN npm ci
RUN npx prisma generate --schema prisma/schema.prisma
COPY apps/admin-panel apps/admin-panel
RUN npm run build --workspace=@backtix-service/admin-panel

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/admin-panel/build ./apps/admin-panel/build
COPY --from=builder /app/apps/admin-panel/package.json ./apps/admin-panel/package.json
COPY --from=builder /app/apps/admin-panel/tsconfig.json ./apps/admin-panel/tsconfig.json
USER node
WORKDIR /app/apps/admin-panel
EXPOSE 3001
CMD ["node", "build"]
